# Application
NODE_ENV=development
PORT=3000
APP_NAME=gateway-identity-service

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=identity_service
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cookie / Session
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# CORS (comma-separated list to whitelist multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Login Security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Internal JWT (Gateway → Downstream)
GATEWAY_PRIVATE_KEY_PATH=./certs/private.pem
INTERNAL_JWT_TTL_SECONDS=300

# Downstream Services (leave empty to disable routing to that service)
INVENTORY_SERVICE_URL=http://localhost:3001
BILLING_SERVICE_URL=http://localhost:3002
CLINICAL_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
